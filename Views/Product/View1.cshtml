@model List<Product>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>
                <a asp-controller="Product" asp-action="View2" asp-route-id="@item.Id">
                    Details
                </a>
            </td>
        </tr>
    }
</table>